@model List<MensajeViewModel>
@{
    ViewData["Title"] = "Chat con el Agente";
    var propiedadId = ViewBag.PropiedadId;
    var agenteId = ViewBag.AgenteId;
    var agenteNombre = ViewBag.AgenteNombre ?? "Agente";
    var codigoPropiedad = ViewBag.CodigoPropiedad;
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-chat-dots"></i> Chat con @agenteNombre</h2>
            <p class="text-muted">Propiedad: <strong>@codigoPropiedad</strong></p>
            <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedadId" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver a Detalle de Propiedad
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-circle"></i> @agenteNombre
                    </h5>
                </div>
                <div class="card-body bg-light" style="max-height: 500px; overflow-y: auto;" id="chatMessages">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var mensaje in Model.OrderBy(m => m.FechaEnvio))
                        {
                            var esCliente = mensaje.EmisorId == userId;
                            <div class="mb-3 @(esCliente ? "text-end" : "")">
                                <div class="d-inline-block" style="max-width: 70%;">
                                    @if (!esCliente)
                                    {
                                        <small class="text-muted d-block mb-1">
                                            <strong><i class="bi bi-person"></i> @mensaje.EmisorNombre</strong>
                                        </small>
                                    }
                                    <div class="p-3 rounded @(esCliente ? "bg-primary text-white" : "bg-white border")">
                                        <p class="mb-1">@mensaje.Contenido</p>
                                        <small class="@(esCliente ? "text-white-50" : "text-muted")">
                                            <i class="bi bi-clock"></i> @mensaje.FechaEnvio.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    @if (esCliente)
                                    {
                                        <small class="text-muted d-block mt-1">
                                            <i class="bi bi-check-all"></i> Tú
                                        </small>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-chat-square-text" style="font-size: 4rem; opacity: 0.3;"></i>
                            <p class="mt-3"><strong>Inicia la conversación</strong></p>
                            <p class="text-muted">Envía un mensaje al agente para obtener más información sobre esta propiedad.</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-white">
                    <form asp-action="EnviarMensajeChat" method="post">
                        <input type="hidden" name="propiedadId" value="@propiedadId" />
                        <input type="hidden" name="agenteId" value="@agenteId" />
                        <div class="input-group">
                            <input type="text" 
                                   name="mensaje" 
                                   class="form-control" 
                                   placeholder="Escribe tu mensaje..." 
                                   required 
                                   autofocus />
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send-fill"></i> Enviar
                            </button>
                        </div>
                        <small class="text-muted form-text">
                            <i class="bi bi-info-circle"></i> El agente recibirá tu mensaje y podrá responderte.
                        </small>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="alert alert-info">
                <i class="bi bi-lightbulb"></i> 
                <strong>Consejo:</strong> Pregunta por detalles específicos, condiciones de pago, disponibilidad para visitas, etc.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Scroll automático al último mensaje
        var chatDiv = document.getElementById('chatMessages');
        if (chatDiv) {
            chatDiv.scrollTop = chatDiv.scrollHeight;
        }

        // Auto-scroll cuando se carga la página
        window.addEventListener('load', function() {
            if (chatDiv) {
                chatDiv.scrollTop = chatDiv.scrollHeight;
            }
        });
    </script>
    <style>
        #chatMessages::-webkit-scrollbar {
            width: 8px;
        }
        #chatMessages::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        #chatMessages::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }
        #chatMessages::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
    </style>
}
