@model List<PropiedadViewModel>
@{
    ViewData["Title"] = "Mis Propiedades Favoritas";
}

<div class="container">
    
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Home
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="bi bi-heart-fill"></i> Mis Favoritas
            </li>
        </ol>
    </nav>

    
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-5">
                <i class="bi bi-heart-fill text-danger"></i> Mis Propiedades Favoritas
            </h1>
            <p class="lead text-muted">Propiedades que has guardado para revisar más tarde</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Buscar más propiedades
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        
        <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle"></i>
            Tienes <strong>@Model.Count</strong> @(Model.Count == 1 ? "propiedad favorita" : "propiedades favoritas")
        </div>

        
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var propiedad in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm hover-shadow">
                        
                        <div class="position-relative">
                            @if (!string.IsNullOrEmpty(propiedad.ImagenPrincipal))
                            {
                                <img src="~/@propiedad.ImagenPrincipal" 
                                     class="card-img-top" 
                                     alt="@propiedad.TipoPropiedad"
                                     style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-secondary d-flex align-items-center justify-content-center" 
                                     style="height: 200px;">
                                    <i class="bi bi-house-door text-white" style="font-size: 4rem;"></i>
                                </div>
                            }
                            
                            
                            <form asp-controller="Cliente" 
                                  asp-action="EliminarFavorito" 
                                  asp-route-propiedadId="@propiedad.Id"
                                  asp-route-returnUrl="@Url.Action("MisPropiedades", "Cliente")"
                                  method="post" 
                                  class="position-absolute top-0 end-0 m-2">
                                <button type="submit" 
                                        class="btn btn-danger btn-sm rounded-circle"
                                        title="Quitar de favoritos">
                                    <i class="bi bi-heart-fill"></i>
                                </button>
                            </form>

                            
                            <div class="position-absolute bottom-0 start-0 m-2">
                                <span class="badge bg-dark">@propiedad.Codigo</span>
                            </div>
                        </div>

                        <div class="card-body">
                            
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="text-muted mb-0">
                                    <i class="bi bi-house-door-fill"></i> @propiedad.TipoPropiedad
                                </h6>
                                <span class="badge bg-success">@propiedad.TipoVenta</span>
                            </div>

                            <h5 class="card-title text-primary fw-bold">
                                @propiedad.Precio.ToString("C0") DOP
                            </h5>

                            
                            <div class="d-flex justify-content-between text-muted mb-3">
                                <small>
                                    <i class="bi bi-door-closed"></i> @propiedad.CantidadHabitaciones Hab.
                                </small>
                                <small>
                                    <i class="bi bi-droplet"></i> @propiedad.CantidadBanos Baños
                                </small>
                                <small>
                                    <i class="bi bi-arrows-angle-expand"></i> @propiedad.TamanoEnMetros m²
                                </small>
                            </div>

                            
                            @if (propiedad.Mejoras != null && propiedad.Mejoras.Any())
                            {
                                <div class="mb-3">
                                    @foreach (var mejora in propiedad.Mejoras.Take(3))
                                    {
                                        <span class="badge bg-light text-dark me-1">
                                            <i class="bi bi-check-circle-fill text-success"></i> @mejora
                                        </span>
                                    }
                                    @if (propiedad.Mejoras.Count > 3)
                                    {
                                        <span class="badge bg-light text-dark">
                                            +@(propiedad.Mejoras.Count - 3) más
                                        </span>
                                    }
                                </div>
                            }

                            
                            <p class="card-text mb-3">
                                <small class="text-muted">
                                    <i class="bi bi-person-badge"></i> @propiedad.NombreAgente
                                </small>
                            </p>

                            
                            <a asp-controller="Home" 
                               asp-action="Details" 
                               asp-route-id="@propiedad.Id" 
                               class="btn btn-primary w-100">
                                <i class="bi bi-eye"></i> Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-heart display-1 text-muted"></i>
            </div>
            <h3 class="text-muted mb-3">Aún no tienes propiedades favoritas</h3>
            <p class="lead text-muted mb-4">
                Explora nuestro catálogo y guarda las propiedades que te interesen
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-search"></i> Explorar Propiedades
            </a>
        </div>
    }
</div>

@section Styles {
    <style>
        .hover-shadow {
            transition: all 0.3s ease;
        }

        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2) !important;
        }

        .card-img-top {
            transition: all 0.3s ease;
        }

        .card:hover .card-img-top {
            transform: scale(1.05);
        }
    </style>
}
