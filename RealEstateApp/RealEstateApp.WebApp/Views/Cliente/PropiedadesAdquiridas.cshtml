@model List<RealEstateApp.Application.ViewModels.Propiedades.PropiedadDetalleViewModel>
@{
    ViewData["Title"] = "Mis Propiedades Adquiridas";
    var cantidadPropiedades = ViewBag.CantidadPropiedades ?? 0;
    var ofertasAceptadas = ViewBag.OfertasAceptadas as List<RealEstateApp.Application.ViewModels.Ofertas.OfertaViewModel> ?? new List<RealEstateApp.Application.ViewModels.Ofertas.OfertaViewModel>();
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">
                <i class="bi bi-house-check-fill text-success"></i> Mis Propiedades Adquiridas
            </h1>
            <p class="lead">Propiedades que has adquirido mediante ofertas aceptadas</p>
        </div>
    </div>

    
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-house-fill"></i> Propiedades Adquiridas
                    </h5>
                    <h2 class="display-4">@cantidadPropiedades</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-currency-dollar"></i> Inversión Total
                    </h5>
                    <h2 class="display-4">
                        @ofertasAceptadas.Sum(o => o.MontoOferta).ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO"))
                    </h2>
                </div>
            </div>
        </div>
    </div>

    
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var propiedad in Model)
            {
                var ofertaAceptada = ofertasAceptadas.FirstOrDefault(o => o.PropiedadId == propiedad.Id);
                
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        
                        <div class="position-relative">
                            @if (propiedad.Imagenes != null && propiedad.Imagenes.Any())
                            {
                                <img src="~/@propiedad.Imagenes.First()" class="card-img-top" alt="@propiedad.TipoPropiedad" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <img src="~/images/no-image.png" class="card-img-top" alt="Sin imagen" style="height: 200px; object-fit: cover;">
                            }
                            <span class="badge bg-success position-absolute top-0 end-0 m-2">
                                <i class="bi bi-check-circle-fill"></i> ADQUIRIDA
                            </span>
                        </div>

                        <div class="card-body">
                            
                            <h6 class="text-muted mb-2">@propiedad.TipoPropiedad - @propiedad.TipoVenta</h6>
                            <h5 class="card-title">Código: @propiedad.Codigo</h5>
                            
                            
                            <div class="mb-3">
                                <p class="mb-1">
                                    <strong>Precio Original:</strong>
                                    <span class="text-decoration-line-through text-muted">
                                        @propiedad.Precio.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO"))
                                    </span>
                                </p>
                                @if (ofertaAceptada != null)
                                {
                                    <p class="mb-0">
                                        <strong>Precio Pagado:</strong>
                                        <span class="text-success fw-bold">
                                            @ofertaAceptada.MontoOferta.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO"))
                                        </span>
                                    </p>
                                    
                                    var ahorro = propiedad.Precio - ofertaAceptada.MontoOferta;
                                    var porcentajeAhorro = (ahorro / propiedad.Precio) * 100;
                                    
                                    if (ahorro > 0)
                                    {
                                        <p class="text-success small mb-0">
                                            <i class="bi bi-piggy-bank"></i> Ahorro: @ahorro.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO")) (@porcentajeAhorro.ToString("F1")%)
                                        </p>
                                    }
                                }
                            </div>
                            
                            
                            <div class="d-flex justify-content-between mb-3">
                                <span title="Habitaciones">
                                    <i class="bi bi-door-open"></i> @propiedad.CantidadHabitaciones
                                </span>
                                <span title="Baños">
                                    <i class="bi bi-droplet"></i> @propiedad.CantidadBanos
                                </span>
                                <span title="Tamaño">
                                    <i class="bi bi-rulers"></i> @propiedad.TamanoEnMetros m²
                                </span>
                            </div>

                            
                            @if (propiedad.Agente != null)
                            {
                                <div class="border-top pt-3 mb-3">
                                    <p class="small mb-1"><strong>Agente:</strong></p>
                                    <p class="small mb-0">
                                        <i class="bi bi-person"></i> @propiedad.Agente.NombreCompleto
                                    </p>
                                    @if (!string.IsNullOrEmpty(propiedad.Agente.Telefono))
                                    {
                                        <p class="small mb-0">
                                            <i class="bi bi-telephone"></i> @propiedad.Agente.Telefono
                                        </p>
                                    }
                                </div>
                            }

                            
                            @if (ofertaAceptada != null)
                            {
                                <p class="small text-muted mb-2">
                                    <i class="bi bi-calendar-check"></i> Adquirida: @ofertaAceptada.FechaCreacion.ToString("dd/MM/yyyy")
                                </p>
                            }

                            
                            <div class="d-grid">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedad.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-eye"></i> Ver Detalles Completos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> 
            <p class="mb-0">Aún no has adquirido ninguna propiedad.</p>
            <p class="mb-0">Explora nuestras propiedades disponibles y envía ofertas.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                <i class="bi bi-search"></i> Explorar Propiedades
            </a>
        </div>
    }

    
    <div class="row mt-4">
        <div class="col-12 text-center">
            <a asp-controller="Cliente" asp-action="MisOfertas" class="btn btn-secondary">
                <i class="bi bi-list-ul"></i> Ver Todas Mis Ofertas
            </a>
        </div>
    </div>
</div>
