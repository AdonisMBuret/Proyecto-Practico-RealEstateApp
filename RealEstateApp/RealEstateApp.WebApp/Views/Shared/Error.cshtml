@model RealEstateApp.Application.ViewModels.Common.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg border-warning">
            <div class="card-body text-center p-5">
                <div class="mb-4">
                    <i class="bi bi-exclamation-triangle text-warning" style="font-size: 5rem;"></i>
                </div>
                
                <h2 class="text-warning mb-3">¡Oops! Algo salió mal</h2>
                
                <p class="lead text-muted mb-4">
                    Ocurrió un error inesperado. Nuestro equipo ha sido notificado.
                </p>
                
                @if (!string.IsNullOrEmpty(Model.RequestId))
                {
                    <div class="alert alert-info" role="alert">
                        <small>
                            <strong>ID de Solicitud:</strong> @Model.RequestId
                        </small>
                    </div>
                }
                
                <div class="mt-4">
                    <h6>Posibles soluciones:</h6>
                    <ul class="list-unstyled text-muted">
                        <li><i class="bi bi-arrow-right"></i> Actualiza la página</li>
                        <li><i class="bi bi-arrow-right"></i> Verifica tu conexión a internet</li>
                        <li><i class="bi bi-arrow-right"></i> Intenta nuevamente en unos minutos</li>
                    </ul>
                </div>
                
                <hr class="my-4">
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                    <button onclick="location.reload()" class="btn btn-outline-secondary me-md-2">
                        <i class="bi bi-arrow-clockwise"></i> Recargar Página
                    </button>
                    <a href="javascript:history.back()" class="btn btn-secondary me-md-2">
                        <i class="bi bi-arrow-left"></i> Volver Atrás
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house"></i> Ir al Inicio
                    </a>
                </div>
                
                <div class="mt-4">
                    <small class="text-muted">
                        Si el problema persiste, contacta al soporte técnico.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>