@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle text-primary" style="font-size: 4rem;"></i>
                    <h2 class="mt-3">Iniciar Sesión</h2>
                    <p class="text-muted">Ingresa tus credenciales para continuar</p>
                </div>

                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                   
                    <div class="mb-3">
                        <label asp-for="UsuarioOCorreo" class="form-label">
                            <i class="bi bi-person"></i> Usuario o Correo Electrónico
                        </label>
                        <input asp-for="UsuarioOCorreo" class="form-control form-control-lg" placeholder="Ingresa tu usuario o correo" autofocus />
                        <span asp-validation-for="UsuarioOCorreo" class="text-danger"></span>
                    </div>

                   
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            <i class="bi bi-lock"></i> Contraseña
                        </label>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="Ingresa tu contraseña" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    
                    <div class="mb-3 form-check">
                        <input asp-for="RecordarMe" class="form-check-input" />
                        <label asp-for="RecordarMe" class="form-check-label">
                            Recordarme
                        </label>
                    </div>

                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                        </button>
                    </div>

                   
                    <hr class="my-4" />
                    
                    <div class="text-center">
                        <p class="mb-0">
                            ¿No tienes una cuenta? 
                            <a asp-action="Register" class="fw-bold text-decoration-none">Regístrate aquí</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
