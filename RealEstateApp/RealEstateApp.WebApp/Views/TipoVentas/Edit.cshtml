@model RealEstateApp.Application.ViewModels.Catalogos.SaveTipoVentaViewModel
@{
    ViewData["Title"] = "Editar Tipo de Venta";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <div class="mb-4">
                <h1 class="display-6">
                    <i class="bi bi-pencil-square text-primary"></i> Editar Tipo de Venta
                </h1>
                <p class="text-muted">Modifique los datos del tipo de venta <strong>ID: @Model.Id</strong></p>
            </div>

            
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-pencil"></i> Actualizar Información</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        
                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label required">
                                <i class="bi bi-tag"></i> Nombre del Tipo de Venta
                            </label>
                            <input asp-for="Nombre" class="form-control form-control-lg" 
                                   placeholder="Ej: Venta, Alquiler, Traspaso, etc." 
                                   maxlength="100" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> El nombre debe ser único en el sistema
                            </div>
                        </div>

                        
                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label required">
                                <i class="bi bi-card-text"></i> Descripción
                            </label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4" 
                                      placeholder="Descripción detallada del tipo de venta..."
                                      maxlength="500"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> Proporcione una descripción detallada de este tipo de venta
                            </div>
                        </div>

                        
                        <div class="row">
                            <div class="col-12">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                                        <i class="bi bi-arrow-left"></i> Volver al Listado
                                    </a>
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="bi bi-save"></i> Guardar Cambios
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            
            <div class="mt-4">
                <div class="alert alert-warning" role="alert">
                    <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Importante:</h6>
                    <ul class="mb-0">
                        <li>Los cambios afectarán todas las propiedades que tengan este tipo de venta asignado</li>
                        <li>Asegúrese de que el nuevo nombre no entre en conflicto con tipos existentes</li>
                        <li>La descripción actualizada será visible para agentes y clientes</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <style>
        .required::after {
            content: " *";
            color: #dc3545;
            font-weight: bold;
        }
        
        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }
        
        .form-control-lg {
            font-size: 1.1rem;
            padding: 0.75rem 1rem;
        }
    </style>

    <script>
        $(document).ready(function() {
            // Auto-focus en el primer campo
            $('#Nombre').focus().select();
            
            // Contador de caracteres para descripción
            $('#Descripcion').on('input', function() {
                const maxLength = 500;
                const currentLength = $(this).val().length;
                const remaining = maxLength - currentLength;
                
                let helpText = $(this).next('.text-danger').next('.form-text');
                if (helpText.length === 0) {
                    helpText = $(this).siblings('.form-text');
                }
                
                if (remaining <= 50) {
                    helpText.html(`<i class="bi bi-exclamation-circle text-warning"></i> ${remaining} caracteres restantes`);
                } else {
                    helpText.html('<i class="bi bi-info-circle"></i> Proporcione una descripción detallada de este tipo de venta');
                }
            });
        });
    </script>
}
