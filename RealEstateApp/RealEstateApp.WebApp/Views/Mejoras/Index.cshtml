@model IEnumerable<RealEstateApp.Application.ViewModels.Catalogos.MejoraViewModel>
@{
    ViewData["Title"] = "Mantenimiento de Mejoras";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-5">
                    <i class="bi bi-stars text-primary"></i> Mantenimiento de Mejoras
                </h1>
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Crear Nueva Mejora
                </a>
            </div>
            <p class="text-muted">Gestione las mejoras disponibles para las propiedades</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul"></i> Lista de Mejoras
                            <span class="badge bg-light text-dark ms-2">@Model.Count() mejoras registradas</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="text-center" style="width: 80px;">#</th>
                                        <th scope="col">Nombre</th>
                                        <th scope="col">Descripción</th>
                                        <th scope="col" class="text-center" style="width: 150px;">
                                            <i class="bi bi-house-fill"></i> Propiedades
                                        </th>
                                        <th scope="col" class="text-center" style="width: 200px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mejora in Model)
                                    {
                                        <tr>
                                            <td class="text-center text-muted">#@mejora.Id</td>
                                            <td>
                                                <strong>@mejora.Nombre</strong>
                                            </td>
                                            <td>
                                                <span class="text-muted">@mejora.Descripcion</span>
                                            </td>
                                            <td class="text-center">
                                                @if (mejora.CantidadPropiedades > 0)
                                                {
                                                    <span class="badge bg-info">@mejora.CantidadPropiedades propiedades</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Sin propiedades</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group" aria-label="Acciones">
                                                    
                                                    <a asp-action="Edit" asp-route-id="@mejora.Id" 
                                                       class="btn btn-sm btn-outline-primary" title="Editar mejora">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>
                                                    
                                                    
                                                    <a asp-action="Delete" asp-route-id="@mejora.Id" 
                                                       class="btn btn-sm btn-outline-danger" title="Eliminar mejora">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-stars display-1 text-muted mb-3"></i>
                        <h3 class="text-muted">No hay mejoras registradas</h3>
                        <p class="text-muted mb-4">Comience creando su primera mejora para las propiedades</p>
                        <a asp-action="Create" class="btn btn-success btn-lg">
                            <i class="bi bi-plus-circle"></i> Crear Primera Mejora
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .table th {
            border-top: none;
            font-weight: 600;
        }
        
        .btn-group .btn {
            margin: 0 2px;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.1);
        }
    </style>
}
