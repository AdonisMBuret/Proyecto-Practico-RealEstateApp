@model List<RealEstateApp.Application.ViewModels.Chat.ConversacionViewModel>
@{
    ViewData["Title"] = "Conversaciones de la Propiedad";
    var propiedadId = ViewBag.PropiedadId as int?;
}

<div class="container">
 
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">
                    <i class="bi bi-house-door"></i> Home del Agente
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedadId">
                    Detalle Propiedad
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Conversaciones</li>
        </ol>
    </nav>


    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5">
                        <i class="bi bi-chat-dots text-primary"></i> 
                        Conversaciones de Clientes
                    </h1>
                    <p class="lead text-muted">
                        Clientes que han enviado mensajes sobre esta propiedad
                        <span class="badge bg-primary ms-2">@Model.Count cliente(s)</span>
                    </p>
                </div>
                <div>
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedadId" 
                       class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Volver a Detalle
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-center bg-primary text-white">
                    <div class="card-body">
                        <i class="bi bi-people-fill display-4"></i>
                        <h4 class="mt-2">@Model.Count</h4>
                        <p class="mb-0">Clientes Activos</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center bg-success text-white">
                    <div class="card-body">
                        <i class="bi bi-chat-fill display-4"></i>
                        <h4 class="mt-2">@(Model.Sum(c => c.TotalMensajes))</h4>
                        <p class="mb-0">Total Mensajes</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center bg-warning text-white">
                    <div class="card-body">
                        <i class="bi bi-envelope-fill display-4"></i>
                        <h4 class="mt-2">@(Model.Count(c => c.TieneNuevosMensajes))</h4>
                        <p class="mb-0">Conversaciones Nuevas</p>
                    </div>
                </div>
            </div>
        </div>

      
        <div class="row">
            @foreach (var conversacion in Model.OrderByDescending(c => c.UltimoMensajeFecha))
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow @(conversacion.TieneNuevosMensajes ? "border-primary" : "")">
                  
                        <div class="card-header @(conversacion.TieneNuevosMensajes ? "bg-primary text-white" : "bg-light")">
                            <div class="row align-items-center">
                                <div class="col-8">
                                    <h5 class="mb-0">
                                        <i class="bi bi-person-circle"></i>
                                        @conversacion.ClienteNombre
                                    </h5>
                                </div>
                                <div class="col-4 text-end">
                                    @if (conversacion.TieneNuevosMensajes)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-circle"></i> NUEVO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-check-all"></i> LEÍDO
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-body">
                      
                            <div class="mb-3">
                                <small class="text-muted">Último mensaje:</small>
                                <p class="mb-2 bg-light p-2 rounded">
                                    <i class="bi bi-quote"></i>
                                    "@(conversacion.UltimoMensaje.Length > 100 ? conversacion.UltimoMensaje.Substring(0, 100) + "..." : conversacion.UltimoMensaje)"
                                </p>
                            </div>

                        
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Total Mensajes</small>
                                    <div class="fw-bold fs-6">
                                        <span class="badge bg-info">@conversacion.TotalMensajes</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Mensajes No Leídos</small>
                                    <div class="fw-bold fs-6">
                                        @if (conversacion.MensajesNoLeidos > 0)
                                        {
                                            <span class="badge bg-danger">@conversacion.MensajesNoLeidos</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">0</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            
                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="bi bi-clock"></i>
                                    Última actividad: 
                                    @if (conversacion.UltimoMensajeFecha.Date == DateTime.Today)
                                    {
                                        <span class="fw-bold text-success">
                                            Hoy a las @conversacion.UltimoMensajeFecha.ToString("HH:mm")
                                        </span>
                                    }
                                    else if (conversacion.UltimoMensajeFecha.Date == DateTime.Today.AddDays(-1))
                                    {
                                        <span class="fw-bold text-warning">
                                            Ayer a las @conversacion.UltimoMensajeFecha.ToString("HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            @conversacion.UltimoMensajeFecha.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                </small>
                            </div>

                           
                            <div class="mb-2">
                                @if (conversacion.EsConversacionActiva)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-chat-heart"></i> Conversación Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-chat-square"></i> Inactiva
                                    </span>
                                }
                            </div>
                        </div>

                    
                        <div class="card-footer">
                            <div class="d-grid">
                                <a asp-action="Chat" 
                                   asp-route-propiedadId="@propiedadId" 
                                   asp-route-clienteId="@conversacion.ClienteId"
                                   class="btn @(conversacion.TieneNuevosMensajes ? "btn-primary" : "btn-outline-primary")">
                                    <i class="bi bi-chat-left-text"></i> 
                                    Abrir Chat con @conversacion.ClienteNombre
                                    @if (conversacion.MensajesNoLeidos > 0)
                                    {
                                        <span class="badge bg-danger ms-2">@conversacion.MensajesNoLeidos</span>
                                    }
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

     
        <div class="row mt-4">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body">
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-info-circle"></i> Consejos para una Comunicación Efectiva
                        </h6>
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-clock text-primary"></i>
                                        <strong>Respuesta rápida:</strong> Contesta en menos de 24 horas
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-emoji-smile text-success"></i>
                                        <strong>Tono profesional:</strong> Mantén una comunicación cordial
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-info-square text-info"></i>
                                        <strong>Información completa:</strong> Responde todas las preguntas
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-calendar-check text-warning"></i>
                                        <strong>Citas:</strong> Ofrece visitas a la propiedad
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-chat-dots display-1 text-muted mb-4"></i>
                        <h3 class="text-muted">No hay conversaciones para esta propiedad</h3>
                        <p class="lead text-muted mb-4">
                            Los clientes aún no han enviado mensajes. 
                            Una vez que lo hagan, aparecerán aquí.
                        </p>
                        <div class="d-grid gap-2 d-md-block">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedadId" 
                               class="btn btn-primary btn-lg">
                                <i class="bi bi-arrow-left"></i> Volver a la Propiedad
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-house-door"></i> Ver Mis Propiedades
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .hover-shadow {
            transition: all 0.3s ease;
        }
        .hover-shadow:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        }
        
        .card.border-primary {
            box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.25);
        }
        
        .card.border-primary:hover {
            box-shadow: 0 8px 25px rgba(13, 110, 253, 0.3) !important;
        }
    </style>

    <script>
        $(document).ready(function() {
           
            $('.border-primary').each(function(index) {
                $(this).delay(index * 200).queue(function() {
                    $(this).addClass('shadow-lg').dequeue();
                });
            });
            
           
            setInterval(function() {
                $('.border-primary .badge.bg-warning').fadeOut(500).fadeIn(500);
            }, 2000);
            
            
            if ($('.border-primary').length > 0) {
              
                console.log(`Tienes ${$('.border-primary').length} conversación(es) nueva(s)`);
            }
        });
    </script>
}