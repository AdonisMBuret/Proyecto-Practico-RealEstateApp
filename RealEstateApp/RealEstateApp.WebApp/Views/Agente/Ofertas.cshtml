@model List<OfertasClienteViewModel>
@{
    ViewData["Title"] = "Ofertas de la Propiedad";
    var propiedadId = ViewBag.PropiedadId as int?;
}

<div class="container">
    
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">
                    <i class="bi bi-house-door"></i> Home del Agente
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedadId">
                    Detalle Propiedad
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Ofertas</li>
        </ol>
    </nav>

    
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5">
                        <i class="bi bi-currency-dollar text-success"></i> 
                        Ofertas Recibidas
                    </h1>
                    <p class="lead text-muted">
                        Clientes que han realizado ofertas para esta propiedad
                        <span class="badge bg-primary ms-2">@Model.Count cliente(s)</span>
                    </p>
                </div>
                <div>
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedadId" 
                       class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Volver a Detalle
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center bg-primary text-white">
                    <div class="card-body">
                        <i class="bi bi-people-fill display-4"></i>
                        <h4 class="mt-2">@Model.Count</h4>
                        <p class="mb-0">Clientes Interesados</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-success text-white">
                    <div class="card-body">
                        <i class="bi bi-currency-exchange display-4"></i>
                        <h4 class="mt-2">@Model.Sum(o => o.CantidadOfertas)</h4>
                        <p class="mb-0">Total Ofertas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-warning text-white">
                    <div class="card-body">
                        <i class="bi bi-clock-fill display-4"></i>
                        <h4 class="mt-2">@Model.Count(o => o.TieneOfertasPendientes)</h4>
                        <p class="mb-0">Pendientes</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-info text-white">
                    <div class="card-body">
                        <i class="bi bi-cash-stack display-4"></i>
                        <h4 class="mt-2">
                            @Model.Max(o => o.UltimaOferta.MontoOferta).ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO"))
                        </h4>
                        <p class="mb-0">Oferta Máxima</p>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="row">
            @foreach (var clienteOferta in Model.OrderByDescending(o => o.UltimaOferta.FechaCreacion))
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow @(clienteOferta.TieneOfertasPendientes ? "border-warning" : "")">
                        
                        <div class="card-header @(clienteOferta.TieneOfertasPendientes ? "bg-warning" : "bg-light")">
                            <div class="row align-items-center">
                                <div class="col-8">
                                    <h5 class="mb-0">
                                        <i class="bi bi-person-circle"></i>
                                        @clienteOferta.ClienteNombre
                                    </h5>
                                </div>
                                <div class="col-4 text-end">
                                    @if (clienteOferta.TieneOfertasPendientes)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-circle"></i> PENDIENTE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-check-circle"></i> REVISADA
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-body">
                            
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Última Oferta</small>
                                    <div class="fw-bold text-success fs-5">
                                        @clienteOferta.UltimaOferta.MontoOferta.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO"))
                                    </div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Total Ofertas</small>
                                    <div class="fw-bold fs-5">
                                        <span class="badge bg-primary fs-6">@clienteOferta.CantidadOfertas</span>
                                    </div>
                                </div>
                            </div>

                            
                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i>
                                    Última actividad: @clienteOferta.UltimaOferta.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            
                            <div class="mb-3">
                                <small class="text-muted">Estado:</small>
                                @switch (clienteOferta.UltimaOferta.EstadoTexto)
                                {
                                    case "Pendiente":
                                        <span class="badge bg-warning text-dark ms-2">
                                            <i class="bi bi-clock"></i> Pendiente de Respuesta
                                        </span>
                                        break;
                                    case "Aceptada":
                                        <span class="badge bg-success ms-2">
                                            <i class="bi bi-check-circle"></i> Aceptada
                                        </span>
                                        break;
                                    case "Rechazada":
                                        <span class="badge bg-danger ms-2">
                                            <i class="bi bi-x-circle"></i> Rechazada
                                        </span>
                                        break;
                                }
                            </div>

                            
                            @if (!string.IsNullOrEmpty(clienteOferta.UltimaOferta.Comentarios))
                            {
                                <div class="mb-3">
                                    <small class="text-muted">Comentarios:</small>
                                    <p class="small bg-light p-2 rounded">
                                        "@clienteOferta.UltimaOferta.Comentarios"
                                    </p>
                                </div>
                            }
                        </div>

                        
                        <div class="card-footer">
                            <div class="d-grid">
                                <a asp-action="OfertasCliente" 
                                   asp-route-propiedadId="@propiedadId" 
                                   asp-route-clienteId="@clienteOferta.ClienteId"
                                   class="btn @(clienteOferta.TieneOfertasPendientes ? "btn-warning" : "btn-outline-primary")">
                                    <i class="bi bi-eye"></i> 
                                    Ver Todas las Ofertas de @clienteOferta.ClienteNombre
                                    @if (clienteOferta.TieneOfertasPendientes)
                                    {
                                        <i class="bi bi-exclamation-circle ms-2"></i>
                                    }
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        
        <div class="row mt-4">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body">
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-info-circle"></i> Información sobre Ofertas
                        </h6>
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-clock text-warning"></i>
                                        <strong>Ofertas Pendientes:</strong> Requieren tu respuesta
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle text-success"></i>
                                        <strong>Al Aceptar:</strong> La propiedad se marca como vendida
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-x-circle text-danger"></i>
                                        <strong>Al Rechazar:</strong> Puedes agregar comentarios
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-shield-check text-primary"></i>
                                        <strong>Automático:</strong> Otras ofertas se rechazan al aceptar una
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-currency-dollar display-1 text-muted mb-4"></i>
                        <h3 class="text-muted">No hay ofertas para esta propiedad</h3>
                        <p class="lead text-muted mb-4">
                            Los clientes aún no han realizado ofertas. 
                            Asegúrate de que la propiedad esté bien promocionada.
                        </p>
                        <div class="d-grid gap-2 d-md-block">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedadId" 
                               class="btn btn-primary btn-lg">
                                <i class="bi bi-arrow-left"></i> Volver a la Propiedad
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-house-door"></i> Ver Mis Propiedades
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .hover-shadow {
            transition: all 0.3s ease;
        }
        .hover-shadow:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        }
        
        .card.border-warning {
            box-shadow: 0 0 0 2px rgba(255, 193, 7, 0.25);
        }
        
        .card.border-warning:hover {
            box-shadow: 0 8px 25px rgba(255, 193, 7, 0.3) !important;
        }
    </style>

    <script>
        $(document).ready(function() {
            // Destacar ofertas pendientes con animación
            $('.border-warning').each(function(index) {
                $(this).delay(index * 200).queue(function() {
                    $(this).addClass('shadow-lg').dequeue();
                });
            });
            
            // Efecto de pulsación para ofertas pendientes
            setInterval(function() {
                $('.border-warning .badge.bg-warning').fadeOut(500).fadeIn(500);
            }, 2000);
        });
    </script>
}
