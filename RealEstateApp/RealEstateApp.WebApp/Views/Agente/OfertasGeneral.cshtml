@model List<RealEstateApp.Application.ViewModels.Ofertas.OfertasPorPropiedadViewModel>
@{
    ViewData["Title"] = "Todas mis Ofertas";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">
                    <i class="bi bi-house-door"></i> Home del Agente
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Ofertas</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5">
                        <i class="bi bi-currency-dollar text-success"></i> 
                        Todas mis Ofertas
                    </h1>
                    <p class="lead text-muted">
                        Ofertas recibidas en todas tus propiedades
                        <span class="badge bg-primary ms-2">@Model.Sum(o => o.CantidadOfertas) oferta(s) total</span>
                    </p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Volver al Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center bg-primary text-white">
                    <div class="card-body">
                        <i class="bi bi-building display-4"></i>
                        <h4 class="mt-2">@Model.Count</h4>
                        <p class="mb-0">Propiedades con Ofertas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-success text-white">
                    <div class="card-body">
                        <i class="bi bi-currency-exchange display-4"></i>
                        <h4 class="mt-2">@Model.Sum(o => o.CantidadOfertas)</h4>
                        <p class="mb-0">Total Ofertas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-warning text-white">
                    <div class="card-body">
                        <i class="bi bi-clock-fill display-4"></i>
                        <h4 class="mt-2">@Model.Sum(o => o.OfertasPendientes)</h4>
                        <p class="mb-0">Pendientes</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-info text-white">
                    <div class="card-body">
                        <i class="bi bi-cash-stack display-4"></i>
                        <h4 class="mt-2">
                            @Model.Max(o => o.MontoMaximo).ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO"))
                        </h4>
                        <p class="mb-0">Oferta Máxima</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            @foreach (var propiedad in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow @(propiedad.TieneOfertasPendientes ? "border-warning" : "")">
                        <div class="card-header @(propiedad.TieneOfertasPendientes ? "bg-warning" : "bg-light")">
                            <div class="row align-items-center">
                                <div class="col-8">
                                    <h5 class="mb-0">
                                        <i class="bi bi-house-door"></i>
                                        @propiedad.PropiedadCodigo
                                    </h5>
                                    <small>@(propiedad.PropiedadDescripcion.Length > 50 ? propiedad.PropiedadDescripcion.Substring(0, 50) + "..." : propiedad.PropiedadDescripcion)</small>
                                </div>
                                <div class="col-4 text-end">
                                    @if (propiedad.TieneOfertasPendientes)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-circle"></i> PENDIENTE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-check-circle"></i> REVISADA
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Oferta Máxima</small>
                                    <div class="fw-bold text-success fs-5">
                                        @propiedad.MontoMaximo.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO"))
                                    </div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Total Ofertas</small>
                                    <div class="fw-bold fs-5">
                                        <span class="badge bg-primary fs-6">@propiedad.CantidadOfertas</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i>
                                    Última oferta: @propiedad.UltimaOfertaFecha.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <div class="mb-2">
                                @if (propiedad.OfertasPendientes > 0)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock"></i> @propiedad.OfertasPendientes Pendiente(s)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Todas Revisadas
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="d-grid">
                                <a asp-action="OfertasPropiedad" 
                                   asp-route-propiedadId="@propiedad.PropiedadId"
                                   class="btn @(propiedad.TieneOfertasPendientes ? "btn-warning" : "btn-outline-primary")">
                                    <i class="bi bi-eye"></i> 
                                    Ver Todas las Ofertas
                                    @if (propiedad.OfertasPendientes > 0)
                                    {
                                        <span class="badge bg-danger ms-2">@propiedad.OfertasPendientes</span>
                                    }
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-currency-dollar display-1 text-muted mb-4"></i>
                        <h3 class="text-muted">No tienes ofertas</h3>
                        <p class="lead text-muted mb-4">
                            Los clientes aún no han realizado ofertas en tus propiedades.
                        </p>
                        <a asp-action="Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-house-door"></i> Ver Mis Propiedades
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .hover-shadow {
            transition: all 0.3s ease;
        }
        .hover-shadow:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        }
        
        .card.border-warning {
            box-shadow: 0 0 0 2px rgba(255, 193, 7, 0.25);
        }
    </style>
}
