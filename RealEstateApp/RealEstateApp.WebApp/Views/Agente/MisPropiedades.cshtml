@model List<RealEstateApp.Application.ViewModels.Propiedades.PropiedadViewModel>
@{
    ViewData["Title"] = "Mis Propiedades";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">
                    <i class="bi bi-house-door"></i> Home del Agente
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Mis Propiedades</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5">
                        <i class="bi bi-building text-primary"></i> 
                        Mis Propiedades Disponibles
                    </h1>
                    <p class="lead text-muted">
                        Gestión de tus propiedades en venta o alquiler
                        <span class="badge bg-primary ms-2">@Model.Count propiedad(es)</span>
                    </p>
                </div>
                <div>
                    <a asp-action="CrearPropiedad" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Nueva Propiedad
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var propiedad in Model.OrderByDescending(p => p.FechaCreacion))
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow">
                        @if (!string.IsNullOrEmpty(propiedad.ImagenPrincipal))
                        {
                            <img src="~/@propiedad.ImagenPrincipal" class="card-img-top" alt="@propiedad.Codigo" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 250px;">
                                <i class="bi bi-image text-white" style="font-size: 4rem;"></i>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">@propiedad.Codigo</h5>
                                    <small class="text-muted">
                                        <i class="bi bi-tag"></i> @propiedad.TipoPropiedad | 
                                        <i class="bi bi-card-checklist"></i> @propiedad.TipoVenta
                                    </small>
                                </div>
                                <span class="badge @(propiedad.EstadoTexto == "Disponible" ? "bg-success" : "bg-secondary") fs-6">
                                    @propiedad.EstadoTexto
                                </span>
                            </div>

                            <p class="card-text text-muted">
                                @(propiedad.Descripcion.Length > 100 ? propiedad.Descripcion.Substring(0, 100) + "..." : propiedad.Descripcion)
                            </p>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Precio</small>
                                    <div class="fw-bold text-success fs-5">
                                        @propiedad.Precio.ToString("C0", System.Globalization.CultureInfo.CreateSpecificCulture("es-DO"))
                                    </div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Tamaño</small>
                                    <div class="fw-bold">
                                        @propiedad.TamanoEnMetros m²
                                    </div>
                                </div>
                            </div>

                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <i class="bi bi-door-closed text-primary"></i>
                                    <div class="small">@propiedad.CantidadHabitaciones Hab.</div>
                                </div>
                                <div class="col-4">
                                    <i class="bi bi-droplet text-info"></i>
                                    <div class="small">@propiedad.CantidadBanos Baños</div>
                                </div>
                                <div class="col-4">
                                    <i class="bi bi-stars text-warning"></i>
                                    <div class="small">@propiedad.Mejoras.Count Mejoras</div>
                                </div>
                            </div>

                            <div class="text-muted small">
                                <i class="bi bi-calendar"></i> Creada: @propiedad.FechaCreacion.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="card-footer bg-white">
                            <div class="btn-group w-100" role="group">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@propiedad.Id" 
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                                <a asp-action="EditarPropiedad" asp-route-id="@propiedad.Id" 
                                   class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a asp-action="ConversacionesPropiedad" asp-route-propiedadId="@propiedad.Id" 
                                   class="btn btn-outline-info btn-sm">
                                    <i class="bi bi-chat-dots"></i> Mensajes
                                </a>
                                <a asp-action="OfertasPropiedad" asp-route-propiedadId="@propiedad.Id" 
                                   class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-cash-stack"></i> Ofertas
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-building display-1 text-muted mb-4"></i>
                        <h3 class="text-muted">No tienes propiedades disponibles</h3>
                        <p class="lead text-muted mb-4">
                            Comienza creando tu primera propiedad para ofrecerla en el mercado.
                        </p>
                        <a asp-action="CrearPropiedad" class="btn btn-success btn-lg">
                            <i class="bi bi-plus-circle"></i> Crear Primera Propiedad
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .hover-shadow {
            transition: all 0.3s ease;
        }
        .hover-shadow:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        }
    </style>
}
