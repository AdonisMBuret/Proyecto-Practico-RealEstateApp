@model SaveDesarrolladorViewModel
@{
    ViewData["Title"] = "Editar Desarrollador";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
           
            <div class="mb-4">
                <h1 class="display-6">
                    <i class="bi bi-pencil-square text-primary"></i> Editar Desarrollador
                </h1>
                <p class="text-muted">Modifique los datos del desarrollador <strong>@Model.NombreCompleto</strong></p>
            </div>

            
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person-gear"></i> Actualizar Información</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditarDesarrollador" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        
                        <h6 class="text-primary mb-3"><i class="bi bi-person-vcard"></i> Información Personal</h6>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label required">
                                    <i class="bi bi-person"></i> Nombre
                                </label>
                                <input asp-for="Nombre" class="form-control" maxlength="50" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Apellido" class="form-label required">
                                    <i class="bi bi-person"></i> Apellido
                                </label>
                                <input asp-for="Apellido" class="form-control" maxlength="50" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Cedula" class="form-label required">
                                    <i class="bi bi-credit-card-2-front"></i> Cédula
                                </label>
                                <input asp-for="Cedula" class="form-control" maxlength="11" pattern="[0-9]{11}" />
                                <span asp-validation-for="Cedula" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label required">
                                    <i class="bi bi-envelope"></i> Correo Electrónico
                                </label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        
                        <h6 class="text-primary mb-3"><i class="bi bi-key"></i> Información de Cuenta</h6>

                        <div class="row mb-4">
                            <div class="col-md-12">
                                <label asp-for="UserName" class="form-label required">
                                    <i class="bi bi-person-badge"></i> Nombre de Usuario
                                </label>
                                <input asp-for="UserName" class="form-control" maxlength="20" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                        </div>

                      
                        <div class="alert alert-warning" role="alert">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Cambio de Contraseña</h6>
                            <p class="mb-0">Deje los campos de contraseña vacíos si no desea cambiarla</p>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">
                                    <i class="bi bi-lock"></i> Nueva Contraseña (Opcional)
                                </label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Dejar vacío para mantener actual" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">
                                    <i class="bi bi-lock-fill"></i> Confirmar Nueva Contraseña
                                </label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirmar nueva contraseña" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                       
                        <div class="row">
                            <div class="col-12">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a asp-action="Desarrolladores" class="btn btn-secondary btn-lg">
                                        <i class="bi bi-arrow-left"></i> Volver al Listado
                                    </a>
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="bi bi-save"></i> Guardar Cambios
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

          
            <div class="mt-4">
                <div class="alert alert-info" role="alert">
                    <h6 class="alert-heading"><i class="bi bi-info-circle"></i> Consideraciones importantes:</h6>
                    <ul class="mb-0">
                        <li><strong>Email y Usuario únicos:</strong> Deben ser únicos en todo el sistema</li>
                        <li><strong>Contraseña opcional:</strong> Solo se actualiza si proporciona una nueva</li>
                        <li><strong>Cambios inmediatos:</strong> Los cambios se aplicarán de inmediato</li>
                        <li><strong>Acceso técnico:</strong> Mantiene acceso a funcionalidades de desarrollo</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <style>
        .required::after {
            content: " *";
            color: #dc3545;
            font-weight: bold;
        }
        
        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }
    </style>

    <script>
        $(document).ready(function() {
            
            $('#Nombre').focus().select();
            
          
            $('#Cedula').on('input', function() {
                this.value = this.value.replace(/\D/g, '').substring(0, 11);
            });
            
            
            $('#ConfirmPassword').on('keyup', function() {
                const password = $('#Password').val();
                const confirmPassword = $(this).val();
                
                if (password !== confirmPassword && confirmPassword.length > 0) {
                    $(this).addClass('is-invalid');
                } else {
                    $(this).removeClass('is-invalid');
                }
            });
            
            
            $('#Password').on('input', function() {
                if ($(this).val() === '') {
                    $('#ConfirmPassword').val('');
                }
            });
        });
    </script>
}
