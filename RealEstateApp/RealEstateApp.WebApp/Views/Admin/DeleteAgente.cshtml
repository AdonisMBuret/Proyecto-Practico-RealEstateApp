@model AgenteViewModel
@{
    ViewData["Title"] = "Eliminar Agente";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Agentes">Gestión de Agentes</a>
            </li>
            <li class="breadcrumb-item active">Eliminar</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle"></i> ¡Advertencia!
                        </h5>
                        <p class="mb-0">
                            ¿Está seguro que desea eliminar este agente y todas sus propiedades?
                        </p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.UrlImagenPerfil))
                            {
                                <img src="~/@Model.UrlImagenPerfil" 
                                     alt="@Model.NombreCompleto" 
                                     class="rounded-circle img-thumbnail" 
                                     style="width: 150px; height: 150px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto" 
                                     style="width: 150px; height: 150px;">
                                    <i class="bi bi-person text-white" style="font-size: 4rem;"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <h3>@Model.NombreCompleto</h3>
                            <hr />
                            <dl class="row">
                                <dt class="col-sm-4">Email:</dt>
                                <dd class="col-sm-8">@Model.Email</dd>

                                <dt class="col-sm-4">Teléfono:</dt>
                                <dd class="col-sm-8">@(Model.Telefono ?? "N/A")</dd>

                                <dt class="col-sm-4">Propiedades:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-danger fs-6">@Model.CantidadPropiedades propiedades</span>
                                </dd>

                                <dt class="col-sm-4">Estado:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.EsActivo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <h6>
                            <i class="bi bi-info-circle"></i> Esta acción:
                        </h6>
                        <ul class="mb-0">
                            <li>Eliminará al agente <strong>@Model.NombreCompleto</strong> del sistema</li>
                            <li>Eliminará <strong>@Model.CantidadPropiedades</strong> propiedades asociadas</li>
                            <li><strong class="text-danger">No se puede deshacer</strong></li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Agentes" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancelar
                        </a>
                        <form asp-action="DeleteAgenteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Sí, Eliminar Agente y Propiedades
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
